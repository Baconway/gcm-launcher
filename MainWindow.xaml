<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="sinmai_launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:sinmai_launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="sinmai-launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Main Application Dashboard -->
        <Grid x:Name="DashboardRoot" RowDefinitions="Auto,Auto,*" Margin="24,16,24,24">
            
            <!-- Top App Bar / Profile Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Profile Info (Filepaths hidden per FEEDBACK.md) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PersonPicture x:Name="HeaderProfilePic" Width="44" Height="44" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderProfileName" Text="Player Profile" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="GameBadgeBorder" Background="#260078D4" CornerRadius="4" Padding="6,1,6,2">
                                <TextBlock x:Name="HeaderGameBadge" Text="maimai DX" FontSize="11" Foreground="#0078D4" FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Launch Game Button in between -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="LaunchGameBtn" Style="{ThemeResource AccentButtonStyle}" Padding="20,8" CornerRadius="6" Click="LaunchGameBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="Launch Game" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopGameBtn" Visibility="Collapsed" Background="#D83B01" Foreground="White" Padding="16,8" CornerRadius="6" Click="StopGameBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="Stop Game" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Name="LaunchProgressRing" IsActive="False" Visibility="Collapsed" Width="22" Height="22" />
                    <Border x:Name="LaunchStatusBadge" Background="#1A107C41" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#107C41" />
                            <TextBlock x:Name="StatusText" Text="Ready to Launch" FontSize="12" Foreground="#107C41" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Profile Selector, Palette & Management -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Profile:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ProfileSelectorCombo" MinWidth="140" />
                    <Button x:Name="NewProfileBtn" ToolTipService.ToolTip="Create a new profile" Click="NewProfileBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditProfileBtn" ToolTipService.ToolTip="Edit current profile" Click="EditProfileBtn_Click">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                    <Button x:Name="DeleteProfileBtn" ToolTipService.ToolTip="Delete current profile" Click="DeleteProfileBtn_Click">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>

                    <AppBarSeparator Margin="4,0" />

                    <!-- Custom Color Palette Selector -->
                    <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Color Palette" />
                    <ComboBox x:Name="PaletteSelectorCombo" MinWidth="130" ToolTipService.ToolTip="Select color palette theme" />
                </StackPanel>
            </Grid>

            <!-- Notification / InfoBar -->
            <InfoBar x:Name="MainInfoBar" Grid.Row="1" IsOpen="False" Margin="0,0,0,12" VerticalAlignment="Bottom" />

            <!-- Main Content Tabs -->
            <TabView Grid.Row="2" x:Name="MainTabs" IsAddTabButtonVisible="False" SelectedIndex="0">
                <!-- Tab 1: Display & Launch Settings -->
                <TabViewItem Header="Display &amp; Launch" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE7F4;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer Padding="4,16,16,16">
                        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                            
                            <!-- Screen Resolution Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Screen Resolution" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Configure game window dimensions passed to Unity application flags (-screen-width and -screen-height)." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    
                                    <Grid ColumnDefinitions="Auto,16,*,16,*" Margin="0,8,0,0">
                                        <ComboBox x:Name="ResolutionPresetCombo" Header="Preset" Width="220">
                                            <ComboBoxItem Content="2160 x 1920 (Cabinet native)" />
                                            <ComboBoxItem Content="1920 x 1080 (Landscape FHD)" />
                                            <ComboBoxItem Content="1080 x 1920 (Portrait FHD)" />
                                            <ComboBoxItem Content="2560 x 1440 (2K QHD)" />
                                            <ComboBoxItem Content="3840 x 2160 (4K UHD)" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>

                                        <NumberBox x:Name="ScreenWidthBox" Grid.Column="2" Header="Width (px)" SpinButtonPlacementMode="Inline" Minimum="640" Maximum="7680" />
                                        <NumberBox x:Name="ScreenHeightBox" Grid.Column="4" Header="Height (px)" SpinButtonPlacementMode="Inline" Minimum="480" Maximum="4320" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Window & Screen Modes Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Window Modes" FontSize="16" FontWeight="SemiBold" />
                                    
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Fullscreen Mode (-screen-fullscreen)" FontWeight="Medium" />
                                            <TextBlock Text="Toggle whether the game starts in exclusive fullscreen or windowed mode." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FullscreenSwitch" Grid.Column="1" OnContent="On" OffContent="Off" />
                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Borderless / Popup Window (-popupwindow)" FontWeight="Medium" />
                                            <TextBlock Text="Removes window borders when running in windowed mode for seamless cabinet or portrait displays." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="PopupWindowSwitch" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Console Output Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Console Output" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Configure visibility for AMDaemon background console window." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    
                                    <ComboBox x:Name="ConsoleModeCombo" Width="260" SelectedIndex="0">
                                        <ComboBoxItem Content="Minimized (Default: start /MIN)" />
                                        <ComboBoxItem Content="Visible (Interactive console)" />
                                        <ComboBoxItem Content="Hidden (Background process)" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Injection Protection Card -->
                            <Border Background="#120078D4" BorderBrush="#330078D4" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid ColumnDefinitions="Auto,*">
                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="24" Foreground="#0078D4" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Injection Settings: Protected" FontWeight="SemiBold" Foreground="#0078D4" />
                                        <TextBlock Text="AMDaemon startup flags, Segatools injection, hardware register configurations, and IO updates are strictly locked by the launcher to ensure game stability." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="SaveLaunchSettingsBtn" Style="{ThemeResource AccentButtonStyle}" Content="Save Launch Settings" Padding="20,8" Click="SaveLaunchSettingsBtn_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <!-- Tab 2: Configuration Editor -->
                <TabViewItem Header="Configuration Editor" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE713;" />
                    </TabViewItem.IconSource>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ConfigFileBrowserColumn" Width="260" MinWidth="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Sidebar: Config Files List -->
                        <Border x:Name="ConfigFileBrowserPane" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Configurations" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="Select file to edit" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="CollapseFileBrowserBtn" Grid.Column="1" ToolTipService.ToolTip="Hide file list" Click="CollapseFileBrowserBtn_Click" Padding="6,4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                    </Button>
                                </Grid>
                                <ListView x:Name="ConfigFilesListView" Grid.Row="1" SelectionChanged="ConfigFilesListView_SelectionChanged" SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" Padding="4,6" FontSize="13" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right Pane: Property & Raw File Editor Workspace -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid RowDefinitions="Auto,*">
                                
                                <!-- Editor Header Toolbar -->
                                <Grid Grid.Row="0" Margin="0,0,0,14" ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button x:Name="ToggleFileBrowserBtn" Click="ToggleFileBrowserBtn_Click" ToolTipService.ToolTip="Toggle configuration file list">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                <TextBlock Text="Files" FontSize="12" FontWeight="Medium" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ActiveConfigTitle" Text="Select a configuration file" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ActiveConfigSubtext" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <AutoSuggestBox x:Name="ConfigSearchBox" QueryIcon="Find" PlaceholderText="Search settings..." Width="190" TextChanged="ConfigSearchBox_TextChanged" />
                                        <Button x:Name="SaveConfigBtn" Style="{ThemeResource AccentButtonStyle}" Content="Save Changes" Click="SaveConfigBtn_Click" />
                                        <Button x:Name="ReloadConfigBtn" Content="Reload" Click="ReloadConfigBtn_Click" />
                                        <Button x:Name="ToggleRawEditorBtn" Click="ToggleRawEditorBtn_Click" ToolTipService.ToolTip="Toggle raw file editor">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="13" />
                                                <TextBlock Text="Raw Editor" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Editor Content Grid: TOC | Renderer | Raw Editor -->
                                <Grid Grid.Row="1" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <!-- Column 0: Table of Contents -->
                                        <ColumnDefinition x:Name="ConfigTocColumn" Width="170" MinWidth="120" MaxWidth="360" />
                                        <!-- Column 1: TOC Separator -->
                                        <ColumnDefinition x:Name="ConfigTocSeparatorColumn" Width="Auto" />
                                        <!-- Column 2: Structured Property Renderer -->
                                        <ColumnDefinition Width="1.1*" MinWidth="300" />
                                        <!-- Column 3: Raw Editor Separator -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Column 4: Raw File Editor (collapsed by default) -->
                                        <ColumnDefinition x:Name="RawEditorColumn" Width="0" MinWidth="0" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Table of Contents (Expands on hover) -->
                                    <Border x:Name="ConfigTocBorder" Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,0,8,0" Background="Transparent">
                                        <Grid RowDefinitions="Auto,*">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="4,0,0,8">
                                                <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="SECTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50" />
                                            </StackPanel>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                <ListView x:Name="TocListView" SelectionMode="Single" SelectionChanged="TocListView_SelectionChanged" Padding="0">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding FullName}" Padding="4,4" />
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- Separator (TOC / Renderer) -->
                                    <Border x:Name="ConfigTocSeparator" Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                                    <!-- Column 2: Structured Property Renderer Area with Dedicated Opaque Sticky Header -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="10,0,10,0">
                                        <!-- Dedicated Opaque Sticky Header Bar Section (Between Filename & Rendered Config) -->
                                        <Border x:Name="StickyHeaderBar" Grid.Row="0"
                                                Background="#1E293B"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="14,8"
                                                Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock x:Name="StickyHeaderTitle" Text="[General]" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="StickyHeaderComment" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock x:Name="StickyHeaderPropCount" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Rendered Properties List -->
                                        <ScrollViewer x:Name="ConfigScrollViewer" Grid.Row="1" Padding="0,0,8,0" ViewChanged="ConfigScrollViewer_ViewChanged">
                                            <StackPanel x:Name="ConfigPropertiesContainer" Spacing="18" HorizontalAlignment="Stretch" />
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Separator (Renderer / Raw Editor) -->
                                    <Border Grid.Column="3" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" />

                                    <!-- Raw File Editor Pane (Spans entire content box, no matter how small, collapsed by default) -->
                                    <Grid Grid.Column="4" RowDefinitions="Auto,*" VerticalAlignment="Stretch" Margin="8,0,0,0">
                                        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Raw File Editor" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Direct Disk Sync" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBox x:Name="RawConfigTextBox" Grid.Row="1"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalAlignment="Stretch"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="Consolas, Cascadia Code, monospace"
                                                 FontSize="12"
                                                 CornerRadius="6"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabViewItem>

                <!-- Tab 3: Game & Mods Overview -->
                <TabViewItem Header="Game &amp; Mods" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE74C;" />
                    </TabViewItem.IconSource>
                    <ScrollViewer Padding="4,16,16,16">
                        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Installation Details" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Game ID / Title:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="OverviewGameTitle" Grid.Row="0" Grid.Column="1" Text="maimai DX" FontWeight="Medium" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Game Root Folder:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="OverviewRootDir" Grid.Row="1" Grid.Column="1" Text="" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Main Executable:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="OverviewExePath" Grid.Row="2" Grid.Column="1" Text="" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch Script:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="OverviewBatPath" Grid.Row="3" Grid.Column="1" Text="" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Installed Mods &amp; Plugins" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Detected DLLs located in Package\Mods\ and Package\Plugins\." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    
                                    <ItemsControl x:Name="DetectedModsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,4">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="#0078D4" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="Medium" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Background="#1A107C41" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Active" FontSize="11" Foreground="#107C41" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Grid>

        <!-- Startup / Create Profile Overlay -->
        <Grid x:Name="StartupOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="WizardTitle" Text="Create Player Profile" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Configure a game profile to start managing and launching your rhythm games." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Game Selection -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Target Game" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="GameRadioMaimai" Content="maimai DX" IsChecked="True" GroupName="TargetGameGroup" />
                                <RadioButton x:Name="GameRadioChunithm" Content="CHUNITHM" GroupName="TargetGameGroup" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Profile Name -->
                        <TextBox x:Name="ProfileNameInput" Header="Profile Name" Text="Player 1" PlaceholderText="Enter profile name" />

                        <!-- Profile Picture -->
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <PersonPicture x:Name="AvatarPreview" Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0" />
                            <TextBox x:Name="AvatarPathInput" Grid.Column="1" Header="Profile Picture (Optional)" PlaceholderText="Path to avatar image (.png, .jpg)" Margin="0,0,8,0" />
                            <Button x:Name="BrowseAvatarBtn" Grid.Column="2" VerticalAlignment="Bottom" Content="Browse..." Click="BrowseAvatarBtn_Click" />
                        </Grid>

                        <!-- Game Directory -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Game Directory" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="GameDirInput" Grid.Column="0" PlaceholderText="e.g. C:\Users\Baconway\Downloads\ga 1.65" Margin="0,0,8,0" />
                                <Button x:Name="BrowseGameDirBtn" Grid.Column="1" Content="Browse..." Click="BrowseGameDirBtn_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- Scan Status InfoBar -->
                        <InfoBar x:Name="WizardScanInfoBar" IsOpen="False" IsClosable="False" />

                        <!-- Actions -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                            <Button x:Name="CancelProfileBtn" Grid.Column="1" Content="Cancel" Margin="0,0,8,0" Click="CancelProfileBtn_Click" Visibility="Collapsed" />
                            <Button x:Name="SubmitProfileBtn" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Content="Create Profile" Click="SubmitProfileBtn_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
